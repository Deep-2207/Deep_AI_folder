# Copy this file to .env and fill in the two Telegram values. Never share .env (the token controls your bot).

# From @BotFather in Telegram (/newbot)
TELEGRAM_BOT_TOKEN=9120666829:AAGdn8elpOXhFS1Po-QuSBicaguCqNLoSvY
# Run `python paper_telegram.py --find-chat-id` after sending "hi" to your bot
TELEGRAM_CHAT_ID=

# What to paper trade: comma list of provider:symbol (yahoo:^NSEI = NIFTY 50, yahoo:^NSEBANK = BANK NIFTY,
# nse:RELIANCE, binance:BTCUSDT)
PAPER_SYMBOLS=yahoo:^NSEI
PAPER_INTERVAL=5m
# Look-ahead in candles (same as the Live page selector); max hold = 4 x this
PAPER_HORIZON=5
# auto = rule, or the self-learning model once it has proven itself | rule | model
PAPER_LOGIC=auto
# off = use every coded pattern (Hammer, Inverted Hammer, Engulfing...) like before the knowledge system
# on  = only patterns/rules you approved on the Knowledge page
PAPER_GATE=off
# always = never WAIT: a CALL or PUT on every closed candle with no trade open (blended score > 0 CALL, < 0 PUT)
# agree  = only when trend and patterns agree (the Live page rule)
PAPER_ENTRY=always
# Target as a multiple of the stop distance (stop = 1.5 x ATR). The Live page "Paper bot" mode uses 1.5 as well.
PAPER_RR=1.5
# Seconds between checks
PAPER_POLL=15
# Daily summary time (IST, weekdays)
PAPER_SUMMARY_AT=15:35
PAPER_API=http://127.0.0.1:5000
